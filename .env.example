# Copy to .env. infra/entra/setup-app-registrations.sh fills in the Entra values.
# Used by docker compose (local) and infra/azure/deploy.sh (Azure).

# --- Migration switches (local docker compose; deploy.sh sets these per phase) ---
PORTAL_AUTH_MODE=cas          # cas | entra
PATRON_API_AUTH_MODE=legacy   # legacy | both | entra
JOB_AUTH_MODE=legacy          # legacy | entra

# --- Legacy (before) ---
LEGACY_API_KEY=change-me-local-only

# --- Optional: step-up MFA for fines via a Conditional Access authentication context ---
# Create an authentication context (e.g. c1) and a CA policy requiring MFA for it, then:
FINES_AUTH_CONTEXT=

# Time zone for calendar reminders (Windows time zone name, as Graph expects)
GRAPH_TIME_ZONE="Pacific Standard Time"

# Demo only: let any Entra user without a seeded patron record get a copy of jstudent's
DEMO_AUTO_PROVISION=true

# --- Entra (written by infra/entra/setup-app-registrations.sh) ---
ENTRA_TENANT_ID=
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
PATRON_API_CLIENT_ID=
PATRON_API_CLIENT_SECRET=
JOB_CLIENT_ID=
JOB_CLIENT_SECRET=
PATRON_API_SCOPES=
PATRON_API_APP_SCOPE=

# --- Azure deployment (infra/azure/deploy.sh) ---
RG=rg-library-entra-poc
LOCATION=westus3
PREFIX=libpoc
